# MongoDB must support transactions (use a replica set, including for local development).
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=sampe

# Replace these placeholders locally; never use them as production credentials.
# Generate a separate random secret (minimum 32 characters) before enabling Owner Report.
OWNER_REPORT_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-password

# Exact browser origins, comma-separated. Example: https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Optional; required only for AI analysis.
EMERGENT_LLM_KEY=
SUMOPOD_AI_API_KEY=
SUMOPOD_AI_MODEL=gpt-4o-mini
